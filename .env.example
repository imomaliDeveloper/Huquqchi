# Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Google Gemini API Configuration (Get your key from https://aistudio.google.com - starts with AIzaSy...)
GEMINI_API_KEY=AIzaSy...

# OpenAI ChatGPT API Configuration (Optional: Dual AI Provider)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (SQLite for Dev, PostgreSQL ready)
DATABASE_URL="file:./dev.db"

# Environment
NODE_ENV=development
