{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/set-webhook",
      "destination": "/api/set-webhook.ts"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
