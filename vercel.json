{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "prisma/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron",
      "destination": "/api/cron.ts"
    },
    {
      "source": "/api/set-webhook",
      "destination": "/api/set-webhook.ts"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
